# Copy to .env (never commit .env). Every value has a dev default in application.yml.
DB_URL=jdbc:postgresql://localhost:55433/ledger
DB_USER=ledger
DB_PASSWORD=ledger
# HS256 signing key, >= 32 bytes. Generate: openssl rand -hex 32
JWT_SECRET=replace-with-64-hex-chars
JWT_TTL_MINUTES=60
RATE_LIMIT_PER_MINUTE=120
# RM 5,000.00 in sen
DAILY_LIMIT_SEN=500000
MAX_SINGLE_AMOUNT_SEN=500000
# Operator account created on startup (both must be set)
ADMIN_EMAIL=admin@ledger.local
ADMIN_PASSWORD=change-me-please
# Project 04 fraud-detection-api base URL; empty disables the risk check
RISK_URL=
RISK_TIMEOUT_MS=800
RISK_FAIL_OPEN=true
WEBHOOK_MAX_ATTEMPTS=8
WEBHOOK_BASE_BACKOFF_MS=2000
